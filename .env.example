SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=voteflow
DB_USER=voteflow
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=django.db.backends.postgresql
# Set to require for Supabase; prefer also supports local PostgreSQL without TLS.
DB_SSLMODE=prefer

# Dragonfly backs shared cache/rate limits and Celery (Redis protocol URL).
DRAGONFLY_URL=redis://localhost:6379/0
# Optional overrides; by default Celery uses DRAGONFLY_URL for both.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Exact browser origin for local development or your custom production domain.
FRONTEND_URL=http://localhost:3000
# Cloudflare Pages project domain (production and preview deployments).
CLOUDFLARE_PAGES_DOMAIN=voteflow-client.pages.dev
# Exact Cloudflare Workers client origin shown in the deployment dashboard.
CLOUDFLARE_WORKERS_ORIGIN=https://voteflow-client.voteflow-test.workers.dev

# Resend transactional email. Use a sender on a domain verified in Resend in production.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=VoteFlow <onboarding@resend.dev>

# Paystack uses NGN. The secret key stays server-side; the public key is
# returned by the checkout endpoint for the browser's InlineJS popup.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Optional image hosting. Without CLOUDINARY_CLOUD_NAME, uploads use local media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional configured identity verification gateway.
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_API_KEY=

# Optional fixed legacy Poll API sunset date (UTC ISO-8601).
# API_SUNSET_AT=2026-11-22T00:00:00+00:00
