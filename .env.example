SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=voteflow
DB_USER=voteflow
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=django.db.backends.postgresql

# Redis backs shared rate limits and the scheduled Celery tasks in deployment.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000

# Resend transactional email. Use a sender on a domain verified in Resend in production.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=VoteFlow <onboarding@resend.dev>

# Paystack uses NGN; keep secret keys on the server only.
PAYSTACK_SECRET_KEY=

# Optional image hosting. Without CLOUDINARY_CLOUD_NAME, uploads use local media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional configured identity verification gateway.
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_API_KEY=

# Optional fixed legacy Poll API sunset date (UTC ISO-8601).
# API_SUNSET_AT=2026-11-22T00:00:00+00:00
